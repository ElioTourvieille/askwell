# Askwell : variables d'environnement (docs/project.md §11). Aucune valeur ici.
# Copier vers .env (ignoré par git) et remplir. Ne jamais committer de secret.

# Neon : URL de l'API Data (public par conception : la RLS est la frontière)
NEXT_PUBLIC_NEON_DATA_API_URL=
# Neon : connexion Postgres directe du rôle app_service, ignore la RLS (serveur uniquement)
DATABASE_URL=
# Neon Object Storage (serveur uniquement) ; Neon les fournit sous AWS_*, renommées ici pour ne pas
# entrer en conflit avec les variables AWS de Vercel
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=

# Clerk : clé publique (côté client)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk : clé secrète (serveur uniquement)
CLERK_SECRET_KEY=
# Clerk : secret de signature du webhook (serveur uniquement)
CLERK_WEBHOOK_SIGNING_SECRET=

# OpenAI : clé API (serveur uniquement)
OPENAI_API_KEY=

# Arcjet : clé (serveur uniquement)
ARCJET_KEY=

# PostHog : clé et hôte (public, client + serveur)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# URL publique de l'application (public, client + serveur)
NEXT_PUBLIC_APP_URL=

# Clé du widget de la landing, lue à chaque requête (serveur ; clé publique mais config par environnement)
LANDING_WIDGET_KEY=
